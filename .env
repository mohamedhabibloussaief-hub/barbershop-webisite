# ════════════════════════════════════════════════════════════════
#  Hazem Coiff — Environment variables template
#  Copy to .env and fill in real values before running.
#  NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════

# ── Django ───────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-secret-key-at-least-50-chars

DEBUG=True

# Comma-separated, no spaces
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ── Database ─────────────────────────────────────────────────────
DB_NAME=hazemcoiff_db
DB_USER=hazemcoiff_user
DB_PASSWORD=hazemcoiff_pass
DB_HOST=db
DB_PORT=5432

# ── CORS (dev: Vite ports; prod: your domain only) ───────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ── JWT ──────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

# ── Email ────────────────────────────────────────────────────────
# Leave blank in dev — emails print to the console (no SMTP needed)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hazemcoiff.tn

# ── Frontend (used by Docker build only) ─────────────────────────
VITE_APP_NAME=Hazem Coiff
